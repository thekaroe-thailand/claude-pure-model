# ═══════════════════════════════════════════════════════════════
#  ใส่ key แล้วรัน:  npm run prove
#  ไฟล์นี้มีความลับ — อย่าส่งให้ใคร อย่า commit (.gitignore กันไว้แล้ว)
# ═══════════════════════════════════════════════════════════════

# ── ตัวที่ตรวจ: Tenixe (จำเป็น) ──
TENIXE_KEY=
TENIXE_URL=https://api.tenixe.com/api/v1
# โมเดลที่ตรวจ และโมเดลที่ใช้เป็นตัวเทียบ (ทั้งคู่ต้องเป็นตัวฟรี — สคริปต์เช็คยอดเงินให้)
TENIXE_SUSPECT_MODEL=claude-haiku-5-5
TENIXE_COMPARE_MODEL=nemotron-3.5-super-vl

# ── ตัวอ้างอิง: Claude อ้างอิง (ใส่อย่างน้อย 1 ทาง) ──

# ทาง A (แนะนำ): API key ของ Anthropic เอง — นับ token ผ่าน count_tokens ไม่ต้องให้โมเดลตอบ
# สร้าง key ที่ https://platform.claude.com/ → API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ทาง B: ผ่าน gateway แบบ OpenAI-compatible ที่รู้ว่าส่งไป Anthropic จริง (เช่น Kob AI ของเรา)
# ทางนี้เสียเงินนิดหน่อยต่อครั้ง (เรียกโมเดลจริง max_tokens 1)
REF_OPENAI_BASE_URL=https://www.kob-ai.dev/v1
REF_OPENAI_KEY=
REF_OPENAI_MODEL=anthropic/claude-haiku-5.5

# ถาม "คุณคือใคร" กับ Claude อ้างอิงด้วยไหม (เสียเงินเล็กน้อย) — 1 = ถาม, 0 = ไม่ถาม
ASK_REFERENCE_IDENTITY=1
